---
// DEV-ONLY layout aid. Delete this component (and its import in Layout.astro)
// before the site goes live.
---

<div class="grid-overlay-wrap" aria-hidden="true">
	<div class="grid-overlay grid" id="grid-overlay"></div>
</div>

<div class="grid-panel" id="grid-panel">
	<div class="grid-panel__row">
		<label for="gp-cols">columns</label>
		<input type="range" id="gp-cols" min="1" max="16" step="1" value="6" />
		<output id="gp-cols-out">6</output>
	</div>
	<div class="grid-panel__row">
		<label for="gp-rows">rows</label>
		<input type="range" id="gp-rows" min="1" max="12" step="1" value="4" />
		<output id="gp-rows-out">4</output>
	</div>
	<div class="grid-panel__row">
		<label for="gp-gutter">gutter</label>
		<input type="range" id="gp-gutter" min="2" max="12" step="1" value="4" />
		<output id="gp-gutter-out">square ÷ 4</output>
	</div>
	<div class="grid-panel__row">
		<label for="gp-margin">margin</label>
		<input type="range" id="gp-margin" min="0" max="3" step="0.25" value="1" />
		<output id="gp-margin-out">1 × gutter</output>
	</div>
	<p class="grid-panel__readout" id="gp-readout"></p>
	<button type="button" id="gp-reset" class="grid-panel__reset">reset</button>
</div>

<button id="grid-toggle" class="grid-toggle" type="button">grid</button>

<style>
	.grid-overlay-wrap {
		position: fixed;
		inset: 0;
		z-index: 9998;
		pointer-events: none;
		display: none;
	}
	:global(body.show-grid) .grid-overlay-wrap {
		display: block;
	}
	.grid-overlay :global(.grid-overlay__cell) {
		outline: 1px solid rgba(220, 40, 40, 0.55);
	}

	.grid-panel {
		position: fixed;
		bottom: 1rem;
		left: 1rem;
		z-index: 9999;
		display: none;
		flex-direction: column;
		gap: 0.4rem;
		padding: 0.75rem 0.9rem;
		background: rgba(17, 17, 17, 0.9);
		color: #fff;
		border-radius: 4px;
		font: 0.7rem/1.3 ui-monospace, SFMono-Regular, Menlo, monospace;
		pointer-events: auto;
	}
	:global(body.show-grid) .grid-panel {
		display: flex;
	}
	.grid-panel__row {
		display: grid;
		grid-template-columns: 4.5rem 8rem auto;
		align-items: center;
		gap: 0.5rem;
	}
	.grid-panel__row input {
		width: 100%;
	}
	.grid-panel__readout {
		margin: 0.2rem 0 0;
		padding-top: 0.5rem;
		border-top: 1px solid rgba(255, 255, 255, 0.25);
		opacity: 0.85;
		user-select: all;
	}
	.grid-panel__reset {
		align-self: flex-start;
		font: inherit;
		background: transparent;
		color: #fff;
		border: 1px solid rgba(255, 255, 255, 0.4);
		border-radius: 3px;
		padding: 0.25rem 0.5rem;
		cursor: pointer;
	}

	.grid-toggle {
		position: fixed;
		bottom: 1rem;
		right: 1rem;
		z-index: 9999;
		font: 0.7rem/1 ui-monospace, SFMono-Regular, Menlo, monospace;
		padding: 0.5rem 0.7rem;
		background: #111;
		color: #fff;
		border: none;
		border-radius: 3px;
		opacity: 0.55;
		cursor: pointer;
		pointer-events: auto;
	}
	.grid-toggle:hover {
		opacity: 1;
	}
</style>

<script>
	const DEFAULTS = { cols: 6, rows: 4, gutter: 4, margin: 1 };

	const overlay = document.getElementById("grid-overlay");
	const readout = document.getElementById("gp-readout");
	const inputs = {
		cols: document.getElementById("gp-cols") as HTMLInputElement,
		rows: document.getElementById("gp-rows") as HTMLInputElement,
		gutter: document.getElementById("gp-gutter") as HTMLInputElement,
		margin: document.getElementById("gp-margin") as HTMLInputElement,
	};
	const outs = {
		cols: document.getElementById("gp-cols-out"),
		rows: document.getElementById("gp-rows-out"),
		gutter: document.getElementById("gp-gutter-out"),
		margin: document.getElementById("gp-margin-out"),
	};

	function apply() {
		const cols = Number(inputs.cols.value);
		const rows = Number(inputs.rows.value);
		const g = Number(inputs.gutter.value); // gutter = square / g
		const m = Number(inputs.margin.value); // margin = m * gutter

		// total size in "squares", along each axis:
		// N squares + (N-1) inner gutters + 2 outer margins
		const wUnits = cols + (cols - 1 + 2 * m) / g;
		const hUnits = rows + (rows - 1 + 2 * m) / g;

		const root = document.documentElement.style;
		root.setProperty("--grid-cols", String(cols));
		root.setProperty("--grid-rows", String(rows));
		root.setProperty(
			"--grid-square",
			`min(calc(100vw / ${wUnits}), calc(100vh / ${hUnits}))`
		);
		root.setProperty("--grid-gutter", `calc(var(--grid-square) / ${g})`);
		root.setProperty("--grid-margin", `calc(var(--grid-gutter) * ${m})`);
		root.setProperty("--grid-width", `calc(var(--grid-square) * ${wUnits})`);
		root.setProperty("--grid-height", `calc(var(--grid-square) * ${hUnits})`);

		// redraw the overlay cells
		if (overlay) {
			overlay.innerHTML = "";
			for (let i = 0; i < cols * rows; i++) {
				const cell = document.createElement("div");
				cell.className = "grid-overlay__cell";
				overlay.appendChild(cell);
			}
		}

		if (outs.cols) outs.cols.textContent = String(cols);
		if (outs.rows) outs.rows.textContent = String(rows);
		if (outs.gutter) outs.gutter.textContent = `square ÷ ${g}`;
		if (outs.margin) outs.margin.textContent = `${m} × gutter`;
		if (readout) {
			readout.textContent =
				`${cols} cols · ${rows} rows · gutter = square/${g} · margin = ${m}× gutter`;
		}
	}

	Object.values(inputs).forEach((el) => el?.addEventListener("input", apply));

	document.getElementById("gp-reset")?.addEventListener("click", () => {
		inputs.cols.value = String(DEFAULTS.cols);
		inputs.rows.value = String(DEFAULTS.rows);
		inputs.gutter.value = String(DEFAULTS.gutter);
		inputs.margin.value = String(DEFAULTS.margin);
		apply();
	});

	document.getElementById("grid-toggle")?.addEventListener("click", () => {
		document.body.classList.toggle("show-grid");
	});
	window.addEventListener("keydown", (e) => {
		const target = e.target as HTMLElement;
		if (target?.tagName === "INPUT" || target?.tagName === "TEXTAREA") return;
		if (e.key.toLowerCase() === "g" && !e.metaKey && !e.ctrlKey && !e.altKey) {
			document.body.classList.toggle("show-grid");
		}
	});

	apply();
</script>
