---
import Layout from "../../layouts/Layout.astro";
import ProjectIndex from "../../components/ProjectIndex.astro";
import { bySection } from "../../data/projects";

// real projects first, in the order their `order:` gives them; the rest of the
// wall stays as placeholders until there is something to put there
const real = bySection("academic").map((p) => ({
	name: p.name,
	href: `/academic/${p.slug}/`,
	image: p.thumb,
}));
const projects = [
	...real,
	...Array.from({ length: Math.max(0, 14 - real.length) }, () => ({ name: "project name" })),
];
---

<Layout
	title="josefjosef — academic"
	section="academic"
	description="School and academic projects by Josef Kučera, from FA ČVUT and the School of Architecture at AVU."
>
	<ProjectIndex projects={projects} />
</Layout>
