---
import Layout from "../../layouts/Layout.astro";
import ProjectIndex from "../../components/ProjectIndex.astro";

// placeholder entries until the real projects arrive
import { bySection } from "../../data/projects";

const real = bySection("architecture").map((p) => ({
	name: p.name,
	href: `/architecture/${p.slug}/`,
	image: p.thumb,
}));
const projects = [
	...real,
	...Array.from({ length: Math.max(0, 14 - real.length) }, () => ({ name: "project name" })),
];
---

<Layout title="josefjosef — architecture" section="architecture">
	<ProjectIndex projects={projects} />
</Layout>
