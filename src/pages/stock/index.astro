---
import Layout from "../../layouts/Layout.astro";
import ProjectIndex from "../../components/ProjectIndex.astro";

// placeholder entries until the real pieces arrive; sold items stay on show
const projects = Array.from({ length: 14 }, (_, i) => {
	const sold = i % 3 === 2;
	return { name: "item name", sold, availability: sold ? "sold" : "available" };
});
---

<Layout
	title="josefjosef — stock"
	section="stock"
	description="Pieces available from the josefjosef workshop."
>
	<ProjectIndex projects={projects} />
</Layout>
