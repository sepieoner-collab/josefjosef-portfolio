---
import Layout from "../../layouts/Layout.astro";
import { bySection, relatedTo, type Project } from "../../data/projects";

export function getStaticPaths() {
	return bySection("works").map((project) => ({
		params: { slug: project.slug },
		props: { project },
	}));
}

const { project } = Astro.props as { project: Project };
const related = relatedTo(project);
---

<Layout title={`josefjosef — ${project.name}`} section="works">
	<section class="screen">
		<div class="grid">
			<p class="proj-name">{project.name}</p>

			<div class="proj-stage">
				<img id="proj-img" src={project.photos[0].src} alt={project.photos[0].caption ?? project.name} />
			</div>

			<button type="button" class="zone zone-prev" data-step="-1" aria-label="Previous photo"></button>
			<button type="button" class="zone zone-full" data-full="1" aria-label="Toggle fullscreen"></button>
			<button type="button" class="zone zone-next" data-step="1" aria-label="Next photo"></button>

			<p class="proj-about">{project.description}</p>
			{related.length > 0 && (
				<p class="proj-related">
					see also{" "}
					{related.map((r, n) => (
						<>
							{n > 0 && ", "}
							<a href={`/${r.section}/${r.slug}/`}>{r.name}</a>
						</>
					))}
				</p>
			)}
			<p class="proj-caption" id="proj-caption">{project.photos[0].caption}</p>
			<p class="proj-dates">{project.dates}</p>
		</div>
	</section>

	<div class="proj-full" id="proj-full">
		<img id="full-img" src={project.photos[0].src} alt={project.photos[0].caption ?? project.name} />
		<button type="button" class="zone zone-prev" data-step="-1" aria-label="Previous photo"></button>
		<button type="button" class="zone zone-full" data-full="1" aria-label="Toggle fullscreen"></button>
		<button type="button" class="zone zone-next" data-step="1" aria-label="Next photo"></button>
	</div>

	<script is:inline define:vars={{ photos: project.photos }}>
		let i = 0;
		const img = document.getElementById("proj-img");
		const full = document.getElementById("full-img");
		const cap = document.getElementById("proj-caption");

		const show = (n) => {
			i = (n + photos.length) % photos.length;
			const p = photos[i];
			img.src = p.src;
			full.src = p.src;
			// the caption doubles as the alt text, so both move together
			img.alt = p.caption ?? "";
			full.alt = p.caption ?? "";
			cap.textContent = p.caption ?? "";
		};

		document.querySelectorAll("[data-step]").forEach((el) =>
			el.addEventListener("click", () => show(i + Number(el.dataset.step)))
		);
		document.querySelectorAll("[data-full]").forEach((el) =>
			el.addEventListener("click", () => document.body.classList.toggle("is-full"))
		);
		// arrow keys, and escape to leave fullscreen
		window.addEventListener("keydown", (e) => {
			if (e.key === "ArrowRight") show(i + 1);
			if (e.key === "ArrowLeft") show(i - 1);
			if (e.key === "Escape") document.body.classList.remove("is-full");
		});
	</script>
</Layout>
